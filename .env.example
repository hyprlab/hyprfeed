# Copy to .env and adjust. Everything is optional for local use.

# Session signing key. If unset, one is generated and stored in the data volume.
SECRET_KEY=

# Cloudflare Turnstile — create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave both empty to run without the challenge (e.g. local development).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ——— Fresh-install defaults ———
# The setup wizard seeds the instance with these; afterwards admins manage
# them at runtime in Settings → Admin, which overrides the values below.

# Allow new account registration (0 to close sign-ups).
ALLOW_REGISTRATION=1

# Background feed refresh interval in minutes (0 pauses refreshing).
REFRESH_MINUTES=15

# How many stories each feed keeps; older ones (read or not) are pruned.
MAX_ENTRIES_PER_FEED=300
